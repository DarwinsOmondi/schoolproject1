{
  "manifest_version": 3,
  "name": "Carbon Tracker",
  "version": "1.0.0",
  "description": "Measure the carbon footprint of your browsing and earn eco-streaks as you stay mindful.",
  "permissions": ["webRequest", "storage", "tabs", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Carbon Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
